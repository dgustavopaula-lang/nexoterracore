:root {
  --bg: #071014;
  --bg-deep: #050b0e;
  --sidebar-bg: #081216;
  --panel: #0b151a;
  --panel-2: #122129;
  --panel-3: #162831;
  --border: #1c303c;
  --border-soft: rgba(170,184,194,.12);
  --text: #f4f7f8;
  --muted: #aab8c2;
  --muted-2: #71808a;
  --accent: #00d99b;
  --accent-hover: #00c896;
  --accent-soft: rgba(0,217,155,.10);
  --accent-border: rgba(0,217,155,.28);
  --danger: #ef6464;
  --sidebar: 280px;
  --radius: 12px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at 72% -10%, rgba(0,217,155,.055), transparent 30%),
    linear-gradient(180deg, var(--bg-deep), var(--bg));
  color: var(--text);
}

body {
  min-height: 100vh;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  transition: background .16s ease, border-color .16s ease, color .16s ease, transform .16s ease;
}

button:active {
  transform: translateY(1px);
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: var(--sidebar) minmax(0, 1fr);
}

/* SIDEBAR */

.sidebar {
  height: 100vh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 24px 18px 20px;
  background:
    linear-gradient(180deg, rgba(18,33,41,.42), transparent 24%),
    var(--sidebar-bg);
  border-right: 1px solid var(--border);
  overflow-y: auto;
}

.brand {
  padding: 2px 8px 24px;
  border-bottom: 1px solid var(--border-soft);
}

.brand strong {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -.35px;
}

.brand strong::before {
  content: "N";
  width: 30px;
  height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  color: var(--accent);
  font-size: 14px;
  font-weight: 800;
}

.brand span {
  display: block;
  margin: 9px 0 0 40px;
  color: var(--muted-2);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1.6px;
}

.menu {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: 22px;
}

.menu-item {
  position: relative;
  width: 100%;
  min-height: 42px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  padding: 0 12px;
  text-align: left;
  cursor: pointer;
  font-size: 13px;
  font-weight: 520;
}

.menu-item:hover {
  background: rgba(18,33,41,.72);
  border-color: rgba(170,184,194,.08);
  color: var(--text);
}

.menu-item.ativo {
  background: linear-gradient(90deg, rgba(0,217,155,.13), rgba(0,217,155,.045));
  border-color: var(--accent-border);
  color: var(--accent);
}

.menu-item.ativo::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 9px;
  bottom: 9px;
  width: 2px;
  border-radius: 2px;
  background: var(--accent);
}

.sidebar-footer {
  margin-top: auto;
  padding: 18px 8px 2px;
  border-top: 1px solid var(--border-soft);
  color: var(--muted);
}

.sidebar-footer strong {
  display: block;
  color: var(--text);
  font-size: 13px;
}

.sidebar-footer span {
  display: block;
  margin-top: 6px;
  color: var(--muted-2);
  font-size: 11px;
}

/* WORKSPACE */

.workspace {
  min-width: 0;
  padding: 0 30px 44px;
}

.topbar {
  min-height: 74px;
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid var(--border);
  background: rgba(5,11,14,.88);
  backdrop-filter: blur(14px);
}

.topbar h1 {
  margin: 0;
  font-size: 20px;
  font-weight: 680;
  letter-spacing: -.4px;
}

.topbar p {
  margin: 4px 0 0;
  color: var(--muted-2);
  font-size: 12px;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.system-status {
  min-height: 38px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: rgba(18,33,41,.55);
}

.system-status span {
  color: var(--muted-2);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.system-status strong {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  font-weight: 650;
  color: var(--text);
}

.system-status strong::before {
  content: "";
  width: 7px;
  height: 7px;
  flex: none;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 4px rgba(0,217,155,.08);
}

/* VIEWS */

.view {
  display: none;
}

.view.ativa {
  display: block;
}

.content {
  width: min(1280px, 100%);
  margin: 28px auto 0;
  min-height: 520px;
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background:
    linear-gradient(145deg, rgba(18,33,41,.38), transparent 34%),
    var(--panel);
  box-shadow: 0 20px 60px rgba(0,0,0,.14);
}

.content h2 {
  margin: 0 0 8px;
  font-size: 22px;
  letter-spacing: -.35px;
}

.content p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 26px;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 26px;
}

.info-card {
  min-height: 108px;
  padding: 20px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 11px;
  background:
    linear-gradient(145deg, rgba(0,217,155,.035), transparent 54%),
    var(--panel-2);
}

.info-card::after {
  content: "";
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, var(--accent), transparent);
  opacity: .18;
}

.info-card span {
  display: block;
  margin-bottom: 10px;
  color: var(--muted-2);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .7px;
}

.info-card strong {
  font-size: 17px;
  font-weight: 660;
}

/* BUTTONS */

.btn-primary,
.btn-secondary,
.btn-icon,
.farm-option,
.btn-table {
  border-radius: 9px;
  cursor: pointer;
}

.btn-primary {
  padding: 10px 16px;
  border: 1px solid var(--accent);
  background: var(--accent);
  color: #04110d;
  font-weight: 700;
}

.btn-primary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
}

.btn-secondary {
  padding: 9px 14px;
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
}

.btn-secondary:hover {
  border-color: var(--accent-border);
  background: var(--accent-soft);
  color: var(--accent);
}

.btn-icon {
  width: 36px;
  height: 36px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  font-size: 21px;
}

.btn-icon:hover {
  border-color: var(--accent-border);
  color: var(--accent);
}

.btn-full {
  width: 100%;
  margin-top: 8px;
}

/* STATES */

.notice,
.empty-state {
  margin-top: 20px;
  padding: 15px 16px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: rgba(18,33,41,.55);
  color: var(--muted);
}

/* TABLE */

.table-wrap {
  width: 100%;
  margin-top: 18px;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.data-table {
  width: 100%;
  min-width: 820px;
  border-collapse: collapse;
  background: rgba(7,16,20,.35);
}

.data-table th,
.data-table td {
  padding: 13px 14px;
  border-bottom: 1px solid var(--border-soft);
  text-align: left;
  vertical-align: top;
}

.data-table th {
  color: var(--muted-2);
  background: rgba(18,33,41,.42);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .75px;
}

.data-table td {
  color: #d9e0e4;
  font-size: 13px;
}

.data-table td strong {
  color: var(--text);
}

/* MODALS */

.oculto {
  display: none !important;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(1,5,7,.82);
  backdrop-filter: blur(8px);
}

.modal-card {
  width: min(440px, 100%);
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background:
    linear-gradient(145deg, rgba(0,217,155,.04), transparent 35%),
    var(--panel);
  box-shadow: 0 30px 90px rgba(0,0,0,.5);
}

.modal-card-wide {
  width: min(840px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.modal-header h2 {
  margin: 5px 0 0;
  font-size: 20px;
}

.eyebrow {
  color: var(--accent);
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.4px;
}

.modal-description {
  margin: 0 0 18px;
  color: var(--muted);
}

.modal-card form {
  display: grid;
  gap: 16px;
}

.modal-card label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 550;
}

.modal-card input,
.modal-card select,
.modal-card textarea {
  width: 100%;
  padding: 11px 12px;
  border: 1px solid var(--border);
  border-radius: 9px;
  outline: none;
  background: #081115;
  color: var(--text);
}

.modal-card input:focus,
.modal-card select:focus,
.modal-card textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(0,217,155,.07);
}

.modal-card textarea {
  min-height: 110px;
  resize: vertical;
}

.form-error {
  min-height: 18px;
  color: var(--danger);
  font-size: 12px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 16px;
}

.form-span-2 {
  grid-column: 1 / -1;
}

.farm-list {
  display: grid;
  gap: 10px;
}

.farm-option {
  width: 100%;
  padding: 14px;
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  text-align: left;
}

.farm-option:hover {
  border-color: var(--accent);
}

.farm-option strong,
.farm-option span {
  display: block;
}

.farm-option span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

.section-actions,
.action-group {
  display: flex;
  align-items: center;
  gap: 9px;
}

.btn-table {
  padding: 7px 10px;
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  font-size: 12px;
}

.btn-table:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.btn-table-danger:hover {
  border-color: var(--danger);
  color: var(--danger);
}

/* SCROLLBAR */

* {
  scrollbar-width: thin;
  scrollbar-color: #23404c transparent;
}

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-thumb {
  background: #23404c;
  border-radius: 999px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

/* RESPONSIVE */

@media (max-width: 1000px) {
  :root {
    --sidebar: 230px;
  }

  .workspace {
    padding: 0 20px 32px;
  }
}

@media (max-width: 720px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    position: relative;
    width: 100%;
    height: auto;
    padding: 16px;
  }

  .brand {
    padding-bottom: 15px;
  }

  .brand span {
    margin-left: 40px;
  }

  .menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    padding-top: 14px;
  }

  .sidebar-footer {
    margin-top: 16px;
  }

  .workspace {
    padding: 0 14px 24px;
  }

  .topbar {
    position: relative;
    align-items: flex-start;
    flex-direction: column;
    padding: 18px 0;
  }

  .topbar-actions {
    width: 100%;
    flex-wrap: wrap;
  }

  .system-status {
    margin-left: auto;
  }

  .content {
    margin-top: 16px;
    min-height: 0;
    padding: 20px;
  }

  .overview-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-span-2 {
    grid-column: auto;
  }

  .section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .section-actions {
    width: 100%;
  }

  .section-actions button {
    flex: 1;
  }
}


/* NexoTerraCore Console — expansão operacional */
.sidebar-toggle {
  width: 42px;
  height: 42px;
  margin: 12px 18px 8px;
  border: 1px solid rgba(120,180,180,.18);
  border-radius: 10px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-size: 20px;
}

.sidebar,
.workspace {
  transition: all .22s ease;
}

body.sidebar-collapsed .sidebar {
  width: 86px;
}

body.sidebar-collapsed .workspace {
  margin-left: 86px;
}

body.sidebar-collapsed .brand span,
body.sidebar-collapsed .brand strong,
body.sidebar-collapsed .sidebar-footer,
body.sidebar-collapsed .menu-item {
  font-size: 0;
}

body.sidebar-collapsed .menu-item::first-letter {
  font-size: 18px;
}

.operational-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.operation-panel {
  border: 1px solid rgba(120,180,180,.15);
  border-radius: 14px;
  padding: 22px;
  background: rgba(13,34,40,.72);
}

.operation-panel h3 {
  margin: 0 0 18px;
  font-size: 20px;
}

.operation-panel p {
  margin: 14px 0 4px;
  opacity: .7;
}

.operation-panel strong {
  display: block;
  font-size: 18px;
}

.operation-panel button {
  width: 100%;
  margin-bottom: 10px;
}

@media (max-width: 900px) {
  .operational-grid {
    grid-template-columns: 1fr;
  }

  body.sidebar-collapsed .sidebar {
    width: 0;
    overflow: hidden;
  }

  body.sidebar-collapsed .workspace {
    margin-left: 0;
  }
}


/* =========================================================
   NEXOTERRACORE — LOGIN PROFISSIONAL
   ========================================================= */

.login-modal {
  background:
    radial-gradient(circle at 15% 20%, rgba(0,217,155,.08), transparent 34%),
    radial-gradient(circle at 85% 80%, rgba(0,217,155,.05), transparent 30%),
    rgba(1,10,13,.94);
  backdrop-filter: blur(12px);
  padding: 30px;
}

.login-shell {
  width: min(1120px, 96vw);
  min-height: 650px;
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  overflow: hidden;
  border-radius: 24px;
  border: 1px solid rgba(120,180,180,.18);
  background: #061217;
  box-shadow: 0 34px 90px rgba(0,0,0,.55);
}

.login-brand-panel {
  position: relative;
  padding: 52px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid rgba(120,180,180,.14);
  background:
    linear-gradient(145deg, rgba(0,217,155,.08), transparent 45%),
    #07171c;
}

.login-brand-top {
  display: flex;
  align-items: center;
  gap: 14px;
}

.login-logo {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  border: 1px solid rgba(0,217,155,.4);
  background: rgba(0,217,155,.10);
  color: #00d99b;
  font-size: 22px;
  font-weight: 800;
}

.login-brand-top strong {
  display: block;
  font-size: 22px;
}

.login-brand-top span {
  display: block;
  margin-top: 3px;
  color: #81959b;
  font-size: 13px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.login-brand-content {
  max-width: 530px;
}

.login-kicker {
  color: #00d99b;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .16em;
}

.login-brand-content h1 {
  margin: 14px 0 16px;
  font-size: clamp(40px, 4vw, 62px);
  line-height: 1.02;
  letter-spacing: -.035em;
}

.login-brand-content > p {
  max-width: 500px;
  margin: 0;
  color: #a7b6bb;
  font-size: 19px;
  line-height: 1.6;
}

.login-status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 38px;
}

.login-status-grid article {
  padding: 17px;
  border: 1px solid rgba(120,180,180,.15);
  border-radius: 14px;
  background: rgba(10,31,37,.72);
}

.login-status-grid span {
  display: block;
  margin-bottom: 8px;
  color: #71878e;
  font-size: 11px;
  letter-spacing: .12em;
}

.login-status-grid strong {
  font-size: 14px;
}

.login-brand-footer {
  color: #657b82;
  font-size: 13px;
}

.login-form-panel {
  position: relative;
  padding: 58px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #09191f;
}

.login-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(120,180,180,.16);
  border-radius: 12px;
  background: transparent;
  color: #a9b7bc;
  font-size: 25px;
  cursor: pointer;
}

.login-close:hover {
  color: #fff;
  border-color: rgba(0,217,155,.4);
}

.login-form-header {
  margin-bottom: 32px;
}

.login-form-header h2 {
  margin: 10px 0 9px;
  font-size: 34px;
  letter-spacing: -.025em;
}

.login-form-header p {
  margin: 0;
  color: #81959b;
  line-height: 1.5;
}

.login-form {
  display: grid;
  gap: 20px;
}

.login-form label {
  display: grid;
  gap: 9px;
  color: #c4d0d4;
  font-size: 14px;
  font-weight: 600;
}

.login-form input {
  width: 100%;
  height: 58px;
  box-sizing: border-box;
  padding: 0 17px;
  border: 1px solid #19343d;
  border-radius: 13px;
  background: #061318;
  color: #eef5f5;
  font-size: 16px;
}

.login-form input:focus {
  border-color: #00d99b;
  box-shadow: 0 0 0 3px rgba(0,217,155,.08);
}

.login-security-note {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #71878e;
  font-size: 13px;
}

.login-security-note span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #00d99b;
  box-shadow: 0 0 12px rgba(0,217,155,.7);
}

.login-submit {
  min-height: 58px;
  margin-top: 4px;
  border-radius: 13px;
  font-size: 16px;
  font-weight: 700;
}

.login-footer-info {
  display: flex;
  gap: 13px;
  align-items: center;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid rgba(120,180,180,.12);
  color: #637980;
  font-size: 12px;
}

.login-footer-info strong {
  color: #8ea2a8;
  font-weight: 500;
}

@media (max-width: 850px) {
  .login-modal {
    padding: 12px;
  }

  .login-shell {
    grid-template-columns: 1fr;
    min-height: auto;
    max-height: 94vh;
    overflow-y: auto;
  }

  .login-brand-panel {
    display: none;
  }

  .login-form-panel {
    min-height: 620px;
    padding: 42px 28px;
  }
}
